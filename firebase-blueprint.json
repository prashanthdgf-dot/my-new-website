{
  "entities": {
    "Inquiry": {
      "title": "Inquiry",
      "description": "User inquiry or membership consultation request",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Full name of the user"
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number"
        },
        "email": {
          "type": "string",
          "description": "Email address"
        },
        "plan": {
          "type": "string",
          "description": "Selected membership plan"
        },
        "message": {
          "type": "string",
          "description": "User inquiry message"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when inquiry was submitted"
        }
      },
      "required": ["name", "phone"]
    },
    "FreeTrialPass": {
      "title": "FreeTrialPass",
      "description": "Free workout trial registration",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Applicant full name"
        },
        "phone": {
          "type": "string",
          "description": "Applicant phone number"
        },
        "preferredTime": {
          "type": "string",
          "description": "Preferred trial slot time"
        },
        "fitnessGoal": {
          "type": "string",
          "description": "Fitness target"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of registration"
        }
      },
      "required": ["name", "phone"]
    },
    "BMILog": {
      "title": "BMILog",
      "description": "BMI assessment calculation record",
      "type": "object",
      "properties": {
        "gender": {
          "type": "string",
          "description": "User gender"
        },
        "age": {
          "type": "number",
          "description": "User age in years"
        },
        "heightCm": {
          "type": "number",
          "description": "User height in centimeters"
        },
        "weightKg": {
          "type": "number",
          "description": "User weight in kilograms"
        },
        "bmi": {
          "type": "number",
          "description": "Calculated Body Mass Index"
        },
        "category": {
          "type": "string",
          "description": "BMI category classification"
        },
        "targetWeight": {
          "type": "number",
          "description": "Target weight in kilograms"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of calculation"
        }
      },
      "required": ["gender", "age", "heightCm", "weightKg", "bmi", "category"]
    },
    "WebhookEvent": {
      "title": "WebhookEvent",
      "description": "Captured external webhook event or callback notification",
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "description": "Origin of the webhook e.g. meta_leads, whatsapp, zapier, razorpay"
        },
        "eventType": {
          "type": "string",
          "description": "Event classification e.g. lead_created, message_received"
        },
        "payload": {
          "type": "object",
          "description": "Complete parsed payload received from the integration"
        },
        "status": {
          "type": "string",
          "description": "Processing status e.g. received, processed, verified"
        },
        "receivedAt": {
          "type": "string",
          "description": "ISO timestamp of receipt"
        }
      },
      "required": ["source"]
    }
  },
  "firestore": {
    "/inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "Collection of membership and general inquiries"
    },
    "/free_trial_passes/{passId}": {
      "schema": "FreeTrialPass",
      "description": "Collection of trial pass registrations"
    },
    "/bmi_logs/{logId}": {
      "schema": "BMILog",
      "description": "Collection of BMI calculation logs"
    },
    "/webhook_events/{eventId}": {
      "schema": "WebhookEvent",
      "description": "Collection of logged webhook events and incoming callbacks"
    }
  }
}
